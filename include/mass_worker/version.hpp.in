#pragma once

#include <array>
#include <cstdint>
#include <string>

// Generated by CMake from version.hpp.in via configure_file — do not edit the
// generated copy in the build tree. The values are baked in at configure time:
// the semantic version from project(VERSION ...), a `git describe` string when
// the source is a git checkout (empty otherwise, e.g. a tarball build), and the
// GPU backend the binary was compiled with.

namespace mass_worker {

// Semantic version, e.g. "0.1.0" — from the top-level project(VERSION ...).
inline constexpr const char* kVersion = "@PROJECT_VERSION@";

// The wire-protocol versions this binary speaks, sent at Register. The hub
// picks the highest version both sides support and rejects the registration
// when the intersection is empty. Bump only on a breaking wire change, and
// keep the older version listed while both are supported. Distribution-level
// semver compat lives in the registry index, not in this binary.
inline constexpr std::array<int32_t, 1> kProtocolVersions{1};

// `git describe --tags --dirty --always` at configure time, e.g.
// "0.1.0-12-gabc1234-dirty". Empty when not a git checkout.
inline constexpr const char* kGitDescribe = "@MASS_WORKER_GIT_DESCRIBE@";

// The primary GPU backend label for --version: "cuda", "metal", "vulkan", or
// "cpu". A binary can compile in MORE than one backend (ggml enumerates devices
// across all of them at runtime); this is just the highest-priority one for the
// version string. Use the kHas* flags below for the real compiled set.
inline constexpr const char* kGpuBackend = "@MASS_WORKER_GPU_BACKEND@";

// Which GPU backends are actually compiled into this binary. More than one can
// be true (e.g. Vulkan + CUDA), and ggml will use devices from each. The setup
// wizard offers only the backends that are both compiled in here AND valid on
// the host OS. cpu is always available.
inline constexpr bool kHasCuda   = @MASS_WORKER_HAS_CUDA@;
inline constexpr bool kHasMetal  = @MASS_WORKER_HAS_METAL@;
inline constexpr bool kHasVulkan = @MASS_WORKER_HAS_VULKAN@;

// A single human-readable line for `--version`, e.g.
// "mass-worker-llama-cpp 0.1.0 (0.1.0-3-gabc1234, vulkan)".
[[nodiscard]] std::string version_string();

// Just the version detail, no program name: "0.1.0 (0.1.0-3-gabc1234, vulkan)".
// Used by --version, where the product name is already the heading.
[[nodiscard]] std::string version_detail();

// The short version shown under the setup banner: the live `git describe`
// string (e.g. "2b9031a-dirty" / "0.1.0-3-gabc1234") for a checkout, or the
// compiled-in semantic version for a tarball build. Mirrors the MASS installer,
// which shows the dirty commit version when the commit isn't tagged.
[[nodiscard]] std::string banner_version();

}  // namespace mass_worker
